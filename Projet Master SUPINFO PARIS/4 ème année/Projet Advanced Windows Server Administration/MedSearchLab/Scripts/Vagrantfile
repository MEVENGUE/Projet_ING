
Vagrant.configure("2") do |config|

#=========================
#
# GLOBAL SETTINGS
#
#=========================

config.vm.boot_timeout = 1800

config.winrm.timeout = 1800
config.winrm.retry_limit = 50

WINDOWS_BOX = "gusztavvargadr/windows-server-2022-standard"

#=========================================================
#
# DC1 - PRIMARY DOMAIN CONTROLLER
#
#=========================================================

config.vm.define "dc1" do |dc1|

dc1.vm.box = WINDOWS_BOX
dc1.vm.hostname = "DC1"

dc1.vm.network "private_network", ip: "192.168.56.10"

dc1.vm.provider "virtualbox" do |vb|
  vb.name = "DC1"

  vb.memory = 4096
  vb.cpus = 2

  vb.gui = true

  vb.customize ["modifyvm", :id, "--graphicscontroller", "vmsvga"]
  vb.customize ["modifyvm", :id, "--vram", "64"]
  vb.customize ["modifyvm", :id, "--nested-hw-virt", "off"]
  vb.customize ["modifyvm", :id, "--paravirtprovider", "hyperv"]
end

dc1.vm.communicator = "winrm"

end

#=========================================================
#
# DC2 - SECOND DOMAIN CONTROLLER
#
#=========================================================

config.vm.define "dc2" do |dc2|

dc2.vm.box = WINDOWS_BOX
dc2.vm.hostname = "DC2"

dc2.vm.network "private_network", ip: "192.168.56.11"

dc2.vm.provider "virtualbox" do |vb|
  vb.name = "DC2"

  vb.memory = 4096
  vb.cpus = 2

  vb.gui = false

  vb.customize ["modifyvm", :id, "--graphicscontroller", "vmsvga"]
  vb.customize ["modifyvm", :id, "--vram", "32"]
  vb.customize ["modifyvm", :id, "--nested-hw-virt", "off"]
  vb.customize ["modifyvm", :id, "--paravirtprovider", "hyperv"]
end

dc2.vm.communicator = "winrm"

end

