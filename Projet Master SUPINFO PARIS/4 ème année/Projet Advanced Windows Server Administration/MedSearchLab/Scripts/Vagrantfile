#=========================================================
#
# CLIENT1
#
#=========================================================

config.vm.define "client1" do |client1|

client1.vm.box = WINDOWS_BOX
client1.vm.hostname = "CLIENT1"

client1.vm.network "private_network", type: "dhcp"

client1.vm.provider "virtualbox" do |vb|
  vb.name = "CLIENT1"

